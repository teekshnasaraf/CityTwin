# ==============================================================================
# CITYTWIN - Environment Configuration Template
# Copy this file to .env and configure your local PostgreSQL credentials.
# Never commit your actual .env file to version control.
# ==============================================================================

# Database Connection (PostgreSQL 18 + PostGIS 3.6)
# Expected format: postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/citytwin
DATABASE_URL=postgresql+psycopg://postgres:<PASSWORD>@localhost:5432/citytwin

# Application Environment (development / testing / production)
ENVIRONMENT=development

# Server Settings
HOST=0.0.0.0
PORT=8000
